{
  "name": "@abundera/sign",
  "version": "0.1.0",
  "description": "Official TypeScript SDK for Abundera Sign, e-signatures with cryptographic evidence: envelopes, templates, webhooks, verification.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "src",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc",
    "test": "vitest run",
    "prepublishOnly": "npm run build",
    "prepare": "npm run build"
  },
  "keywords": [
    "esignature",
    "e-sign",
    "digital-signature",
    "abundera",
    "envelopes",
    "webhooks",
    "audit-trail",
    "rfc3161"
  ],
  "author": "Abundera, Inc.",
  "license": "MIT",
  "homepage": "https://sign.abundera.ai/docs/",
  "repository": {
    "type": "git",
    "url": "https://github.com/abundera/sign-sdk-typescript"
  },
  "engines": {
    "node": ">=18"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "typescript": "^5.4.0",
    "vitest": "^4.1.11"
  }
}
